/* Базовый фон и основной цвет текста */
QWidget, QFrame, QDialog {
    background: #23272e;
    color: #f0f0f0;
    font-size: 10.5pt;
}

/* Заголовки QGroupBox, QLabel (жирные) */
QLabel[fontWeight="75"], QLabel[fontWeight="bold"] {
    color: #f8c471;
    font-weight: bold;
}

/* Кнопки и их плавные границы */
QPushButton {
    background-color: #2d323c;
    color: #ececec;
    border: 1.5px solid #555;
    border-radius: 7px;
    padding: 4px 15px;
}
QPushButton:hover {
    background: #393e4a;
    border: 1.5px solid #989898;
}
QPushButton:pressed {
    background: #1a1a1a;
}

/* Строки ввода и текстовые поля */
QLineEdit, QTextEdit, QComboBox {
    background: #282c34;
    color: #fff;
    border: 1.2px solid #444;
    border-radius: 6px;
    selection-background-color: #568;
}
QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1.8px solid #6baed6;
}

/* Ползунки прокрутки */
QScrollBar {
    background: #23272e;
}
QScrollBar:handle:vertical, QScrollBar:handle:horizontal {
    background: #4d5363;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar:add-line, QScrollBar:sub-line { background: none; }

/* QTabWidget */
QTabWidget::pane { background: #23272e; border-radius: 7px; }
QTabBar::tab {
    background: #2d323c;
    color: #bbb;
    border-radius: 7px;
    padding: 6px 14px;
    margin-right: 2px;
}
QTabBar::tab:selected, QTabBar::tab:hover {
    background: #393e4a;
    color: #fff;
}

/* Поля прогресса */
QProgressBar {
    background-color: #353b45;
    border: 1px solid #444;
    border-radius: 6px;
    color: #efefef;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5e98c6, stop:1 #334c66);
    border-radius: 6px;
}

/* Groupbox */
QGroupBox {
    border: 1px solid #363636;
    border-radius: 8px;
    margin-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 5px;
    color: #e1bc68;
}

/* Tooltip */
QToolTip {
    background: #393939;
    color: #d6d6d6;
    border: 1px solid #484848;
    padding: 5px;
    border-radius: 4px;
    font-size: 11pt;
}

QComboBox QAbstractItemView {
    background-color: #282c34;
    color: #fff;
    selection-background-color: #393939;
    border-radius: 6px;
}
